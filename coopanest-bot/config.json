{
  "botName": "Coopanest Sync",
  "timezone": "America/Sao_Paulo",

  "sync": {
    "intervalMinutes": 60,
    "runOnBoot": true
  },

  "coopanest": {
    "loginUrl": "${COOPANEST_LOGIN_URL}",
    "casesUrl": "${COOPANEST_CASES_URL}",
    "username": "${COOPANEST_USER}",
    "password": "${COOPANEST_PASS}",
    "selectors": {
      "username": "input[name='usuario'], input[name='login'], input[type='text']",
      "password": "input[type='password']",
      "submit": "button[type='submit'], input[type='submit']",
      "loggedIn": "a[href*='sair'], a[href*='logout']"
    },
    "navigationTimeoutMs": 45000,
    "maxHtmlCharsPerChunk": 45000
  },

  "crawl": {
    "maxPages": 60,
    "maxDepth": 3,
    "sameOriginOnly": true,
    "waitAfterLoadMs": 800,
    "maxPaginationClicks": 20,
    "onlyPagesWithData": true,
    "minKeywordMatches": 2,
    "loginUrlPattern": "login|entrar|signin",
    "skipUrlPatterns": [
      "logout",
      "sair",
      "encerrar",
      "sign-?out",
      "excluir",
      "delete",
      "remover",
      "cancelar",
      "imprimir",
      "print",
      "download",
      "export",
      "\\.pdf($|\\?)",
      "\\.xlsx?($|\\?)",
      "\\.docx?($|\\?)",
      "\\.zip($|\\?)",
      "\\.jpe?g($|\\?)",
      "\\.png($|\\?)",
      "^mailto:",
      "^tel:",
      "^javascript:"
    ],
    "nextPageSelectors": [
      "a[rel='next']",
      ".pagination a.next",
      ".pagination li.next a",
      "a[aria-label*='róxima' i]",
      "a[title*='róxima' i]",
      "button[aria-label*='róxima' i]",
      "a:has-text('Próxima')",
      "a:has-text('Proxima')",
      "button:has-text('Próxima')",
      "a:has-text('Próximo')",
      "li.paginate_button.next:not(.disabled) a"
    ],
    "dataKeywords": [
      "paciente",
      "cirurgia",
      "procedimento",
      "anestesi",
      "guia",
      "glosa",
      "convenio",
      "convênio",
      "hospital",
      "valor",
      "conta",
      "aviso",
      "honorario",
      "honorário",
      "pagamento"
    ]
  },

  "doctors": [
    {
      "id": "eduardo",
      "name": "Dr. Eduardo",
      "aliases": ["eduardo", "eduardo melo", "dr eduardo", "dr. eduardo", "emra"]
    },
    {
      "id": "fernanda",
      "name": "Dra. Fernanda",
      "aliases": ["fernanda", "dra fernanda", "dra. fernanda"]
    }
  ],

  "salary": {
    "beneficiary": "Sara",
    "taxRate": 0.2,
    "percentage": 0.05,
    "partners": [
      "datbaby",
      "dat baby",
      "raphael datrino",
      "rafael datrino",
      "datrino",
      "thiago dantas",
      "tiago dantas",
      "thiago",
      "tiago"
    ]
  },

  "sheets": {
    "casesTab": "Cirurgias",
    "salaryTab": "Salario Sara",
    "historyTab": "Historico",
    "caseColumns": [
      "ID",
      "Medico",
      "Paciente",
      "Procedimento",
      "Data",
      "Hospital",
      "Convenio",
      "Status",
      "Valor Bruto",
      "Valor Pago",
      "Valor a Receber",
      "Glosa",
      "Recurso de Glosa",
      "Parceiro/Equipe",
      "Observacoes",
      "Primeira Leitura",
      "Ultima Atualizacao",
      "Mudancas"
    ],
    "salaryColumns": [
      "Mes",
      "Qtd Cirurgias",
      "Valor Bruto",
      "Imposto (20%)",
      "Valor Liquido",
      "Salario Sara (5%)",
      "Atualizado em"
    ],
    "historyColumns": [
      "Quando",
      "ID Cirurgia",
      "Medico",
      "Paciente",
      "Campo",
      "Antes",
      "Depois"
    ]
  },

  "fields": [
    "paciente",
    "medico",
    "procedimento",
    "data",
    "hospital",
    "convenio",
    "status",
    "valorBruto",
    "valorPago",
    "valorReceber",
    "glosa",
    "recursoGlosa",
    "parceiro",
    "observacoes"
  ],

  "watchedFields": [
    "status",
    "valorBruto",
    "valorPago",
    "valorReceber",
    "glosa",
    "recursoGlosa",
    "data",
    "procedimento",
    "convenio"
  ],

  "prompt": {
    "role": "Você é um assistente administrativo de uma equipe de anestesiologia que trabalha com a Coopanest Rio.",
    "rules": [
      "Nunca invente dados. Se um campo não aparece na página, devolva string vazia.",
      "Valores monetários sempre em número (ponto como separador decimal), sem R$ e sem separador de milhar.",
      "Datas sempre no formato DD/MM/AAAA.",
      "Status deve ser copiado literalmente do portal (ex.: 'Pago', 'Em recurso de glosa', 'Glosado', 'Aguardando faturamento').",
      "Ignore cabeçalhos, menus, rodapés e totalizadores: só devolva linhas que sejam cirurgias de verdade.",
      "Responda SEMPRE em português do Brasil."
    ]
  }
}
