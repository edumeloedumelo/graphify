# ---------- Anthropic ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096

# ---------- Coopanest Rio ----------
COOPANEST_LOGIN_URL=https://portal1.coopanestrio.org.br
COOPANEST_USER=
COOPANEST_PASS=
# opcional: por onde comecar a varredura (separe varias por virgula).
# vazio = comeca pela pagina em que o login cai e segue todos os links de la
COOPANEST_CASES_URL=

# ---------- Google Sheets ----------
GOOGLE_SHEET_ID=
# JSON da service account em uma unica linha (ou o base64 dele)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------- Runtime ----------
STATE_DIR=/data
PORT=3000

# ---------- Varredura ----------
SYNC_INTERVAL_MINUTES=60
SYNC_ON_BOOT=true
# limites do crawler (tambem configuraveis em config.json)
CRAWL_MAX_PAGES=60
CRAWL_MAX_DEPTH=3
# token opcional para proteger POST /sync
SYNC_SECRET=
