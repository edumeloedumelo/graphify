# ---------- UltraMsg (WhatsApp) ----------
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# ---------- Anthropic ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096

# ---------- Runtime ----------
STATE_DIR=/data
PORT=3000
LOOKBACK_SECONDS=3600

# vazio = todos os chats liberados; senao lista separada por virgula
ALLOWED_CHATS=
# vazio = todo mundo e admin; senao lista de numeros separada por virgula
ADMIN_NUMBERS=

# ---------- Coopanest Rio ----------
COOPANEST_LOGIN_URL=https://www.coopanestrio.com.br/login
COOPANEST_CASES_URL=
COOPANEST_USER=
COOPANEST_PASS=

# ---------- Grupos de WhatsApp ----------
# chatId de grupo no UltraMsg tem o formato 1203630xxxxxxxxx@g.us
CHAT_EDUARDO=
CHAT_FERNANDA=
# opcional: grupo que recebe o resumo geral + salario da Sara
CHAT_ADMIN=

# ---------- Google Sheets ----------
GOOGLE_SHEET_ID=
# JSON da service account em uma unica linha (ou base64 do JSON)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------- Sincronizacao ----------
SYNC_INTERVAL_MINUTES=60
SYNC_ON_BOOT=true
# token opcional para proteger POST /sync
SYNC_SECRET=
